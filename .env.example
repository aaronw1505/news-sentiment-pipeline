# ---- Required secrets -------------------------------------------------------
# Get a free key at https://newsapi.org/register
NEWSAPI_KEY=your_newsapi_key_here

# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- Optional configuration (sensible defaults shown) -----------------------
# Where the DuckDB database file lives (relative to repo root).
DUCKDB_PATH=data/news.duckdb

# NewsAPI top-headlines parameters.
NEWS_COUNTRY=us
NEWS_PAGE_SIZE=50
# Optional keyword filter, e.g. "technology". Leave blank for general headlines.
NEWS_QUERY=

# Claude model used for classification (Haiku is the cheapest tier).
CLAUDE_MODEL=claude-haiku-4-5
